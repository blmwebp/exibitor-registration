# Copy this file to .env in the project root. Never commit .env.
NODE_ENV=development
PORT=4000
PUBLIC_ORIGIN=http://localhost:5173
# 0 for direct hosting. Set to 1 ONLY behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
# Google App Password, NOT your regular account password (remove spaces).
SMTP_PASS=your-16-character-app-password
MAIL_FROM_NAME=BHARAT Wellness Exhibitor Registration
MAIL_TO=recipient@example.com

# Set a unique admin password of at least 16 characters before starting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require
